---
import { REAL_SKELETON as sk } from '../../lib/figure/pose/realSkeleton';
import { checkFigureFrame } from '../../lib/figure/pose/checkFigureFrame';
import { jointAngles } from '../../lib/figure/pose/validate';
import { ILLUSTRATIVE_SMITH } from '../../lib/figure/geometry/smith';
import { SMITH_SQUAT } from '../../lib/figure/fixtures/smith-squat';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n/locales';
import './figure.css';

interface Props { lang: Locale }
const { lang } = Astro.props;
const deg = (n: number) => `${Math.round(n) || 0}°`;
const STATURES = [150, 165, 175, 190, 200];
const rows = STATURES.flatMap((statureCm) =>
  SMITH_SQUAT.frames.map((frame) => {
    const { solution: sol, findings } = checkFigureFrame(sk, SMITH_SQUAT, frame, { statureCm, smith: ILLUSTRATIVE_SMITH });
    const a = jointAngles(sk, sol.world, 'l');
    return {
      statureCm,
      label: frame.label[lang],
      findings,
      angles: `${t(lang, 'angle.trunk')} ${deg(sol.trunkDeg)} · ${t(lang, 'angle.hip')} ${deg(a.hipFlexDeg)} · ${t(lang, 'angle.knee')} ${deg(a.kneeFlexDeg)} · ${t(lang, 'angle.elbow')} ${deg(a.elbowFlexDeg)}`,
    };
  }),
);
---
<div class="spike-checks-scroll" role="region" tabindex="0" aria-label={t(lang, 'spike.checks.region')}>
<table class="spike-checks">
  <thead>
    <tr>
      <th scope="col">{t(lang, 'spike.check.stature')}</th>
      <th scope="col">{t(lang, 'spike.check.frame')}</th>
      <th scope="col">{t(lang, 'spike.check.angles')}</th>
      <th scope="col">{t(lang, 'spike.check.result')}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td>{r.statureCm} cm</td>
        <td>{r.label}</td>
        <td>{r.angles}</td>
        <td>
          {r.findings.length === 0
            ? <span class="pass">✓ {t(lang, 'spike.check.pass')}</span>
            : <span class="fail">✗ {t(lang, 'spike.check.fail')}: {r.findings.map((f, i) => <>{i > 0 && ', '}<code>{f.check}</code></>)}</span>}
        </td>
      </tr>
    ))}
  </tbody>
</table>
</div>
